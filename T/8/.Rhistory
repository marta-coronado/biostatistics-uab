chimp_boot <- many_resampled_chimps %>% group_by(replicate) %>% summarize(median_asymmetry=median(asymmetryScore))
chimp_boot <- many_resampled_chimps %>% group_by(replicate) %>% dplyr::summarize(median_asymmetry=median(asymmetryScore))
View(chimp_boot)
ggplot(chimp_boot , aes(median_asymmetry)) + geom_histogram()
chimp_boot_CI <- chimp_boot %>%
reframe(CI               = c("lower 95", "upper 95"),  # añade una columna para indicar qué límite del intervalo de confianza estamos calculando
median_asymmetry = quantile(median_asymmetry, probs = c(0.05, 0.95)))  # límites numéricos que separan el 95% central del resto de las réplicas bootstrap
chimp_boot_CI
ggplot(chimp_boot , aes(median_asymmetry)) + geom_histogram()  + geom_vline(xintercept = pull(chimp_boot_CI, median_asymmetry))
chimp
