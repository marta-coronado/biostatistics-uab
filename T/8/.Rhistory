library(ggplot2)
library(ggthemes)
conf_level <- 0.95
alpha <- 1 - conf_level
z_star <- qnorm(1 - alpha)
x <- seq(-4, 4, length=1000)
df <- data.frame(x=x, y=dnorm(x, 0, 1))
ggplot(df, aes(x=x, y=y)) +
geom_line(size=1.2, color="black") +
geom_area(data=subset(df, x <= z_star), aes(x=x, y=y), fill="cadetblue3", alpha=0.5) +
geom_area(data=subset(df, x > z_star), aes(x=x, y=y), fill="firebrick3", alpha=0.4) +
geom_vline(xintercept = z_star, linetype="dashed", color="firebrick3", size=1) +
annotate("text", x=z_star+0.7, y=0.05, label="alpha", parse=TRUE) +
annotate("text", x=0, y=0.25, label=paste0(conf_level*100, "%"), fontface="bold", color="orange4") +
scale_x_continuous(breaks=c(-4, 0, z_star, 4), labels=c(-4, 0, round(z_star, 3), 4)) +
labs(title="Distribución N(0,1): área de un solo lado",
x=expression(z), y="Densidad") +
ggthemes::theme_base(base_size = 13) +
theme(panel.grid=element_blank(),
axis.text=element_text(color="black"),
panel.background = element_rect(fill = "white"))
