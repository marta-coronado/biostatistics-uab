#pagedown::chrome_print("PresentacionBioestadistica.html")
library(ggplot2)
library(ggthemes)
set.seed(14)
# --- Datos originales ---
tratamiento <- c(7.2, 8.3, 4.3, 7.7, 6.2, 4.8, 7.4, 4.1, 5.8, 4.4, 7.1)
control     <- c(2.8, 5.4, 4.6, 5.8, 4.6, 4.4, 5.1, 5.6, 4.1, 3.9, 4.2)
n_treat <- length(tratamiento)
n_ctrl  <- length(control)
# Estadistico observado: diferencia de medias
obs_diff <- mean(tratamiento) - mean(control)
# --- Bootstrap: 1000 iteraciones, remuestreando CADA GRUPO POR SEPARADO ---
# (esto es bootstrap, no permutacion: no se mezclan los grupos)
n_boot <- 1000
boot_diffs <- replicate(n_boot, {
resample_treat <- sample(tratamiento, size = n_treat, replace = TRUE)
resample_ctrl  <- sample(control, size = n_ctrl, replace = TRUE)
mean(resample_treat) - mean(resample_ctrl)
})
boot_df <- data.frame(diff = boot_diffs)
# --- Intervalo de confianza al 95% (percentiles 2.5% y 97.5%) ---
ci <- unname(quantile(boot_diffs, probs = c(0.025, 0.975)))
# Marcamos si cada replica cae dentro o fuera del IC 95%
boot_df$dentro_ci <- boot_df$diff >= ci[1] & boot_df$diff <= ci[2]
# Altura maxima del histograma, para colocar las anotaciones
binwidth <- 0.05
y_max <- max(hist(boot_diffs,
breaks = seq(min(boot_diffs) - binwidth, max(boot_diffs) + binwidth, by = binwidth),
plot = FALSE)$counts)
# --- Grafico ---
p_boot <- ggplot(boot_df, aes(x = diff, fill = dentro_ci)) +
geom_histogram(binwidth = binwidth, color = "black", linewidth = 0.2, alpha = 0.6) +
scale_fill_manual(values = c("FALSE" = "firebrick3", "TRUE" = "cadetblue3"), guide = "none") +
# Lineas de referencia: diferencia = 0 (H0) y diferencia observada
geom_vline(xintercept = 0, color = "black", linewidth = 1) +
geom_vline(xintercept = obs_diff, linetype = "dashed", color = "gray30", linewidth = 1) +
# IC 95%
annotate("segment", x = ci[1], xend = ci[2], y = y_max*1.08, yend = y_max*1.08,
color = "orange4", linewidth = 1,
arrow = arrow(ends = "both", type = "closed", length = unit(0.05, "inches"))) +
annotate("text", x = mean(ci), y = y_max*1.16, label = "95% IC",
fontface = "bold", color = "orange4") +
# Etiquetas de las lineas
annotate("text", x = 0, y = y_max*1.32, label = "Diferencia = 0\nsi H0 es verdadera",
color = "black", hjust = -0.1) +
annotate("text", x = obs_diff, y = y_max*1.32, label = "Diferencia de\nmedias observada",
color = "gray30", hjust = -0.1) +
scale_x_continuous(breaks = seq(0, 3, by = 0.5)) +
scale_y_continuous(limits = c(0, y_max*1.45)) +
labs(
title = "Diferencia de medias en 1.000 réplicas bootstrap",
x = "Diferencia bootstrap de medias",
y = "Frecuencia"
) +
ggthemes::theme_base(base_size = 16) +
theme(panel.grid = element_blank(),
axis.text = element_text(color = "black"),
panel.background = element_rect(fill = "white"),
plot.title = element_text(size = 14))
print(p_boot)
boot_diffs
r sum(boot_diffs <= 0)
sum(boot_diffs <= 0)
