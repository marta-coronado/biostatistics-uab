library(ggplot2)
library(ggthemes)
mu0 <- 170; xbar <- 166.5; SE <- 2
x_left  <- xbar - 4*SE
x_right <- xbar + 4*SE
tipos <- c("Dos colas: H_A: μ ≠ μ0", "Cola inferior: H_A: μ < μ0", "Cola superior: H_A: μ > μ0")
df <- data.frame(
tipo  = factor(tipos, levels = rev(tipos)),
lower = c(xbar - 1.96*SE, -Inf, xbar - 1.645*SE),
upper = c(xbar + 1.96*SE, xbar + 1.645*SE, Inf)
)
df <- df[1:2, ]   # en esta diapo solo bilateral y cola inferior (en la diapo Resumen, quita esta línea)
df$decision <- ifelse(df$lower <= mu0 & df$upper >= mu0,
"μ0 dentro del IC: no rechazamos H0",
"μ0 fuera del IC: rechazamos H0")
df$etiqueta <- paste0("(", ifelse(is.finite(df$lower), round(df$lower, 2), "-∞"), ", ",
ifelse(is.finite(df$upper), round(df$upper, 2), "∞"), ")")
# Intervalos con un extremo infinito: se dibujan hasta el borde con flecha
df$x_ini <- ifelse(is.finite(df$lower), df$lower, x_left)
df$x_fin <- ifelse(is.finite(df$upper), df$upper, x_right)
ggplot(df, aes(y = tipo, color = decision)) +
# Intervalos finitos
geom_segment(data = subset(df, is.finite(lower) & is.finite(upper)),
aes(x = x_ini, xend = x_fin, yend = tipo), size = 1.5) +
# Intervalos con -Inf: flecha a la izquierda
geom_segment(data = subset(df, !is.finite(lower)),
aes(x = x_ini, xend = x_fin, yend = tipo), size = 1.5,
arrow = arrow(length = unit(0.25, "cm"), ends = "first")) +
# Intervalos con Inf: flecha a la derecha
geom_segment(data = subset(df, !is.finite(upper)),
aes(x = x_ini, xend = x_fin, yend = tipo), size = 1.5,
arrow = arrow(length = unit(0.25, "cm"), ends = "last")) +
geom_point(aes(x = xbar), size = 3, color = "black") +
geom_text(aes(x = xbar, label = etiqueta), color = "black", vjust = -1.5, size = 5) +
geom_vline(xintercept = mu0, linetype = "dashed") +
scale_color_manual(values = c("μ0 dentro del IC: no rechazamos H0" = "cadetblue4",
"μ0 fuera del IC: rechazamos H0" = "firebrick3")) +
coord_cartesian(xlim = c(x_left, x_right)) +
labs(x = "Altura (cm). Punto: media muestral. Línea discontinua: μ0 = 170",
y = NULL, color = NULL) +
ggthemes::theme_base(base_size = 16) +
theme(panel.grid = element_blank(),
axis.text = element_text(color = "black"),
panel.background = element_rect(fill = "white"),
legend.position = "bottom")
