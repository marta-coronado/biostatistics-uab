library(ggplot2)
set.seed(123)
n <- 30
reps <- 1000
# 1. Poblaciones no normales
poblaciones <- list(
"Sesgada" = rlnorm(100000, meanlog = 10, sdlog = 0.5),
"Bimodal" = c(rnorm(50000, 20000, 5000), rnorm(50000, 80000, 10000))
)
# 2. Medias muestrales de cada una y dataframe conjunto
df <- do.call(rbind, lapply(names(poblaciones), function(nm) {
pob <- poblaciones[[nm]]
medias <- replicate(reps, mean(sample(pob, n)))
data.frame(
valor = c(pob, medias),
tipo = rep(c("Población", "Medias muestrales (n = 30)"),
c(length(pob), length(medias))),
forma = nm
)
}))
df$tipo <- factor(df$tipo, levels = c("Población", "Medias muestrales (n = 30)"))
# 3. Graficar
ggplot(df, aes(x = valor, fill = tipo)) +
geom_histogram(color = "white", bins = 100, show.legend = FALSE) +
facet_grid(rows = vars(tipo), cols = vars(forma), scales = "free") +
labs(
title = "Teorema central del límite: de poblaciones no normales a una distribución normal",
x = "Valor / Media muestral",
y = "Frecuencia"
) +
scale_fill_manual(values = c("cadetblue4", "orange2")) +
ggthemes::theme_base(base_size = 13) +
theme(panel.grid = element_blank(),
axis.text = element_text(color = "black"),
panel.background = element_rect(fill = "white"),
strip.text = element_text(face = "bold"),
plot.title = element_text(face = "bold", hjust = 0.5))
