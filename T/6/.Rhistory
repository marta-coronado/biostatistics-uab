library(ggplot2)
# Creamos un data frame aproximado para la densidad
x <- seq(10, 35, length.out = 1000)
# Simulamos una densidad aproximada (para visualización)
y <- dnorm(x, mean=25, sd=5)
df <- data.frame(x=x, y=y)
ggplot(df, aes(x=x, y=y)) +
geom_line(size=1) +
geom_ribbon(data=subset(df, x>20 & x<30), aes(ymin=0, ymax=y), fill="blue", alpha=0.4) +
geom_ribbon(data=subset(df, x<20), aes(ymin=0, ymax=y), fill="red", alpha=0.3) +
geom_ribbon(data=subset(df, x>25), aes(ymin=0, ymax=y), fill="green", alpha=0.3) +
labs(title="Longitud de Trypanosoma",
