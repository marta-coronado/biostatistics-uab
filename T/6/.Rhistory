p   # ≈ 0.0958 (9.58 %)
library(ggplot2)
x <- seq(40, 70, length.out = 400)
dens <- dnorm(x, mean = mu, sd = sigma)
df <- data.frame(x = x, y = dens)
shade <- subset(df, x >= 58 & x <= 60)
ggplot(df, aes(x, y)) +
geom_line(color = "blue", size = 1.2) +
geom_ribbon(data = shade, aes(ymin = 0, ymax = y),
fill = "skyblue", alpha = 0.5) +
labs(
title = "Distribución Normal N(54, 4.5²)",
subtitle = paste0("Probabilidad entre 58 y 60 mm = ",
round(p*100, 2), "%"),
x = "Longitud (mm)", y = "Densidad"
) +
theme_minimal(base_size = 16)
