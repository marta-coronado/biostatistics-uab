library(dplyr)
library(knitr)
library(kableExtra)
# Valores de las filas (0.0 a 3.0 por 0.1)
rows <- seq(0, 3.0, by = 0.1)
# Valores de las columnas (0.00 a 0.09 por 0.01)
cols <- seq(0, 0.09, by = 0.01)
# Generar tabla P(Z > z)
z_table <- sapply(cols, function(c){
sapply(rows, function(r){
1 - pnorm(r + c)
})
})
# Convertir a data frame y agregar columna de fila
z_table_df <- as.data.frame(z_table)
z_table_df <- cbind(Z = rows, z_table_df)
# Nombres de columnas tipo tabla Z
colnames(z_table_df) <- c("Z", paste0("0.0", 0:9))
# Resaltar la celda más cercana a P(Z ≥ z) = 0.01
highlight_val <- 0.01
highlight_row <- which.min(abs(z_table_df[,-1] - highlight_val), arr.ind = TRUE)
library(ggplot2)
# Crear secuencia de valores Z
z <- seq(-3, 3, length.out = 1000)
dens <- dnorm(z)
# Valores del intervalo
a <- 0.89
b <- 1.33
# Crear data frame
df <- data.frame(z = z, dens = dens)
# Graficar
ggplot(df, aes(x = z, y = dens)) +
geom_line(size = 1.2) +
geom_ribbon(data = subset(df, z >= a & z <= b),
aes(ymin = 0, ymax = dens),
fill = "skyblue", alpha = 0.5) +
geom_vline(xintercept = a, linetype = "dashed", color = "red", size = 1) +
geom_vline(xintercept = b, linetype = "dashed", color = "red", size = 1) +
annotate("text", x = a, y = 0.25, label = "a = 0.89", color = "red", hjust = 1.2) +
annotate("text", x = b, y = 0.25, label = "b = 1.33", color = "red", hjust = -0.2) +
labs(title = "Área entre Z = 0.89 y Z = 1.33",
subtitle = "P(0.89 ≤ Z ≤ 1.33) = P(Z ≥ 0.89) - P(Z ≥ 1.33)",
x = "Z", y = "Densidad") +
theme_minimal(base_size = 14)
