library(ggplot2)
set.seed(123)
# 1. Población sesgada: distribución exponencial
pop_size <- 10000
pop <- data.frame(value = rexp(pop_size, rate = 0.1)) # media ~10
# 2. Repetimos muestreo y calculamos medias muestrales
n_samples <- 1000
sample_size <- 50
sample_means <- replicate(n_samples, mean(sample(pop$value, sample_size)))
means_df <- data.frame(mean_value = sample_means)
# 3. Graficar
ggplot() +
# Población original
geom_histogram(data = pop, aes(x = value, y = ..density..),
bins = 50, fill = "lightblue", alpha = 0.5) +
# Distribución de medias muestrales
geom_density(data = means_df, aes(x = mean_value),
color = "red", size = 1.2) +
labs(title = "Ejemplo del Teorema Central del Límite",
subtitle = "Población sesgada (azul) vs distribución de medias muestrales (rojo)",
x = "Valor / Media muestral", y = "Densidad") +
theme_minimal(base_size = 14)
