# Parámetros
mu <- 0
sigma <- 1
# Secuencia de valores para la curva
x <- seq(mu - 4*sigma, mu + 4*sigma, length.out = 1000)
df <- data.frame(x = x, y = dnorm(x, mean = mu, sd = sigma))
# Valores para las líneas verticales
sd_lines <- data.frame(
x = c(mu - 3*sigma, mu - 2*sigma, mu - sigma, mu, mu + sigma, mu + 2*sigma, mu + 3*sigma),
label = c("-3σ", "-2σ", "-1σ", "μ", "+1σ", "+2σ", "+3σ")
)
# Segmentos horizontales para mostrar los porcentajes
segments <- data.frame(
y = c(0.03, 0.06, 0.09),        # altura donde poner el segmento
xstart = c(mu - sigma, mu - 2*sigma, mu - 3*sigma),
xend   = c(mu + sigma, mu + 2*sigma, mu + 3*sigma),
label  = c("68%", "95%", "99.7%")
)
# Plot combinado
ggplot(df, aes(x = x, y = y)) +
geom_line(size = 1, color = "blue") +
# Líneas verticales
geom_vline(data = sd_lines, aes(xintercept = x), linetype = "dashed", color = "darkred") +
geom_text(data = sd_lines, aes(x = x, y = 0.1, label = label), angle = 90, vjust = -0.5, color = "darkred") +
# Segmentos horizontales
geom_segment(data = segments, aes(x = xstart, xend = xend, y = y, yend = y), color = "red", size = 2) +
geom_text(data = segments, aes(x = mu, y = y + 0.005, label = label), color = "red") +
# Personalizar eje x
scale_x_continuous(
breaks = sd_lines$x,
labels = sd_lines$label
) +
labs(
title = "Distribución Normal Estándar: Líneas Verticales y Regla Empírica",
x = "Desviaciones Estándar",
y = "Densidad"
) +
theme_minimal()
