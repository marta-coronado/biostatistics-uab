library(ggplot2)
# Parámetros
mu <- 0
sigma <- 1
# Secuencia de valores
x <- seq(mu - 4*sigma, mu + 4*sigma, length.out = 1000)
# Crear data frame
df <- data.frame(
x = x,
y = dnorm(x, mean = mu, sd = sigma)
)
# Función para colorear según SD
df$sd_range <- cut(
x,
breaks = c(-Inf, mu - 3*sigma, mu - 2*sigma, mu - sigma, mu + sigma, mu + 2*sigma, mu + 3*sigma, Inf),
labels = c(">3SD", "2-3SD", "1-2SD", "Within 1SD", "1-2SD", "2-3SD", ">3SD")
)
# Plot
ggplot(df, aes(x = x, y = y, fill = sd_range)) +
geom_area(alpha = 0.5, color = "black") +
scale_fill_brewer(palette = "Set2") +
labs(
title = "Distribución Normal Estándar y Regla Empírica",
x = "Valor",
y = "Densidad",
fill = "Rango SD"
) +
theme_minimal(
)
library(ggplot2)
# Parámetros
mu <- 0
sigma <- 1
# Secuencia de valores para la curva
x <- seq(mu - 4*sigma, mu + 4*sigma, length.out = 1000)
df <- data.frame(x = x, y = dnorm(x, mean = mu, sd = sigma))
# Valores para las líneas de SD
sd_lines <- data.frame(
x = c(mu - 3*sigma, mu - 2*sigma, mu - sigma, mu + sigma, mu + 2*sigma, mu + 3*sigma),
label = c("-3σ", "-2σ", "-1σ", "+1σ", "+2σ", "+3σ")
)
# Plot
ggplot(df, aes(x = x, y = y)) +
geom_line(size = 1, color = "blue") +
geom_vline(data = sd_lines, aes(xintercept = x), linetype = "dashed", color = "red") +
geom_text(data = sd_lines, aes(x = x, y = 0.05, label = label), angle = 90, vjust = -0.5, color = "red") +
labs(
title = "Distribución Normal Estándar y Desviaciones Estándar",
x = "Valor",
y = "Densidad"
) +
theme_minimal()
library(ggplot2)
# Parámetros
mu <- 0
sigma <- 1
# Secuencia de valores para la curva
x <- seq(mu - 4*sigma, mu + 4*sigma, length.out = 1000)
df <- data.frame(x = x, y = dnorm(x, mean = mu, sd = sigma))
# Crear data frame para los segmentos horizontales
segments <- data.frame(
y = c(0.03, 0.06, 0.09),  # altura donde poner el segmento
xstart = c(mu - sigma, mu - 2*sigma, mu - 3*sigma),
xend = c(mu + sigma, mu + 2*sigma, mu + 3*sigma),
label = c("68%", "95%", "99.7%")
)
# Plot
ggplot(df, aes(x = x, y = y)) +
geom_line(size = 1, color = "blue") +
geom_segment(data = segments, aes(x = xstart, xend = xend, y = y, yend = y), color = "red", size = 2) +
geom_text(data = segments, aes(x = mu, y = y + 0.005, label = label), color = "red") +
labs(
title = "Distribución Normal Estándar y Regla Empírica",
x = "Valor",
y = "Densidad"
) +
theme_minimal()
