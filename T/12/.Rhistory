# Separar los datos
x <- mice$Bodyweight[mice$Diet == "chow"]
y <- mice$Bodyweight[mice$Diet == "hf"]
# Calcular las varianzas y tamaños
s1 <- var(x)
s2 <- var(y)
n1 <- length(x)
n2 <- length(y)
# Welch–Satterthwaite df
df <- ( (s1/n1 + s2/n2)^2 ) / ( (s1/n1)^2/(n1-1) + (s2/n2)^2/(n2-1) )
df
x
y
# Separar los datos
x <- na.omit(mice$Bodyweight[mice$Diet == "chow"])
y <- na.omit(mice$Bodyweight[mice$Diet == "hf"])
# Calcular las varianzas y tamaños
s1 <- var(x)
s2 <- var(y)
n1 <- length(x)
n2 <- length(y)
# Welch–Satterthwaite df
df <- ( (s1/n1 + s2/n2)^2 ) / ( (s1/n1)^2/(n1-1) + (s2/n2)^2/(n2-1) )
df
t.test(Bodyweight ~ Diet, data = mice)
t.test(Bodyweight ~ Diet, data = mice, var.equal = TRUE)
