# Redimensionar logo (por ejemplo, 10% del ancho de la página)
logo_resized <- image_scale(logo, "10%")
# Superponer el logo sobre cada página
pages_with_logo <- lapply(pdf_pages, function(page) {
image_composite(
page,
logo_resized,
operator = "over",
gravity = "northeast",   # esquina superior derecha
offset = "+20+20"        # margen desde el borde
)
})
pages_with_logo
# Redimensionar logo (por ejemplo, 10% del ancho de la página)
logo_resized <- image_scale(logo, "30%")
# Superponer el logo sobre cada página
pages_with_logo <- lapply(pdf_pages, function(page) {
image_composite(
page,
logo_resized,
operator = "over",
gravity = "northeast",   # esquina superior derecha
offset = "+20+20"        # margen desde el borde
)
})
pages_with_logo
final_pdf <- image_join(pages_with_logo)
image_write(final_pdf, path = "base_with_logo.pdf", format = "pdf")
