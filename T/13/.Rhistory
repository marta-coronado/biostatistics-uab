)
# Dibujar el boxplot manual en ggplot
ggplot(df, aes(x=1)) +
geom_boxplot(
aes(
ymin = ymin,
lower = lower,
middle = middle,
upper = upper,
ymax = ymax
),
stat = "identity",
fill = "lightblue",
color = "blue",
width = 0.3
) +
scale_y_continuous(limits=c(0,7)) +  # ahora incluye el bigote inferior
labs(title="Boxplot según indicaciones", x="", y="Valores") +
theme_minimal() +
theme(axis.text.x=element_blank(), axis.ticks.x=element_blank())
