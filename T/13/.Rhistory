library(dplyr)
library(knitr)
library(kableExtra)
# --- Parámetros ---
dfs <- 2:25          # grados de libertad
alpha <- 0.05        # nivel de significación
# --- Calcular valores críticos t (cola superior) ---
t_vals <- sapply(dfs, function(df) qt(1 - alpha, df = df))
t_table_df <- data.frame(gl = dfs, `p = 0.05` = round(t_vals, 4))
# --- Añadir valor para df → ∞ ---
