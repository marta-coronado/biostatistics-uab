t_table_df <- bind_rows(t_table_df, t_inf_df)
library(dplyr)
library(knitr)
library(kableExtra)
# --- Parámetros ---
dfs <- 2:25          # grados de libertad
alpha <- 0.05        # nivel de significación
# --- Calcular valores críticos t (cola superior) ---
t_vals <- sapply(dfs, function(df) qt(1 - alpha, df = df))
t_table_df <- data.frame(gl = as.character(dfs), `p = 0.05` = round(t_vals, 4))
# --- Añadir valor para df → ∞ ---
t_inf <- qnorm(1 - alpha)
t_inf_df <- data.frame(gl = "∞", `p = 0.05` = round(t_inf, 4))
# --- Combinar ---
t_table_df <- bind_rows(t_table_df, t_inf_df)
# --- Mostrar tabla ---
kable(t_table_df, row.names = FALSE, digits = 4, align = "c",
caption = "Valores críticos de la distribución t (cola superior, α = 0.05)") %>%
kable_styling(
full_width = FALSE,
position = "center",
font_size = 9,  # letra pequeña
bootstrap_options = c("condensed")
) %>%
row_spec(0, bold = TRUE, background = "#e6f2ff") %>%
column_spec(1, bold = TRUE, background = "#e6f2ff") %>%
row_spec(nrow(t_table_df), bold = TRUE, background = "#ffe6e6")
library(dplyr)
library(knitr)
library(kableExtra)
# --- Parámetros ---
dfs <- 2:25          # grados de libertad
alpha <- 0.05        # nivel de significación (cola superior)
# --- Calcular valores críticos t ---
t_vals <- qt(1 - alpha, df = dfs)
# --- Crear tabla base ---
t_table_df <- data.frame(
gl = as.character(dfs),
`t crítico (p = 0.05)` = round(t_vals, 4)
)
# --- Añadir valor para df → ∞ ---
t_inf <- qnorm(1 - alpha)
t_inf_df <- data.frame(
gl = "∞",
`t crítico (p = 0.05)` = round(t_inf, 4)
)
# --- Combinar ---
t_table_df <- bind_rows(t_table_df, t_inf_df)
# --- Mostrar tabla ---
kable(t_table_df, row.names = FALSE, align = "c",
caption = "Valores críticos de la distribución t (cola superior, α = 0.05)") %>%
kable_styling(
full_width = FALSE,
position = "center",
font_size = 9,  # letra pequeña
bootstrap_options = c("condensed")
) %>%
row_spec(0, bold = TRUE, background = "#e6f2ff") %>%
column_spec(1, bold = TRUE, background = "#e6f2ff") %>%
row_spec(nrow(t_table_df), bold = TRUE, background = "#ffe6e6")
library(dplyr)
library(knitr)
library(kableExtra)
# --- Parámetros ---
df1_vals <- 1:5      # grados de libertad del numerador
df2_vals <- 2:25     # grados de libertad del denominador
alpha <- 0.05        # nivel de significación (cola superior)
# --- Calcular valores críticos F ---
F_table <- sapply(df1_vals, function(df1) qf(1 - alpha, df1 = df1, df2 = df2_vals))
# --- Convertir en data frame ---
F_table_df <- data.frame(df2 = df2_vals, round(F_table, 4))
colnames(F_table_df) <- c("gl2", paste0("gl1 = ", df1_vals))
# --- Mostrar tabla ---
kable(F_table_df, row.names = FALSE, align = "c",
caption = "Valores críticos de la distribución F (cola superior, α = 0.05)") %>%
kable_styling(
full_width = FALSE,
position = "center",
font_size = 9,  # letra pequeña
bootstrap_options = c("condensed")
) %>%
row_spec(0, bold = TRUE, background = "#e6f2ff") %>%
column_spec(1, bold = TRUE, background = "#e6f2ff")
