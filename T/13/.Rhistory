library(dplyr)
library(knitr)
library(kableExtra)
# --- Parámetros ---
dfs <- 2:25         # grados de libertad desde 2 hasta 25
alpha <- 0.05       # nivel de significación
probs <- c(alpha)   # solo una probabilidad
# --- Calcular valores críticos t (cola superior) ---
t_table <- sapply(probs, function(p) qt(1 - p, df = dfs))
t_table_df <- data.frame(df = dfs, round(t_table, 4))
colnames(t_table_df) <- c("gl", "p = 0.05")
# --- Añadir valor para df → ∞ ---
t_inf <- qnorm(1 - alpha)
t_inf_df <- data.frame(gl = "∞", `p = 0.05` = round(t_inf, 4))
# --- Combinar ---
t_table_df <- rbind(t_table_df, t_inf_df)
