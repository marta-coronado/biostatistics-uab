# Define UI for application that draws a histogram
ui <- fluidPage(
titlePanel(HTML('<h1>Study of Relationship between brain weight and body mass</h1>',
'<hr>',
'<h4>Sergi Boluda Baldellou<h4>')),
# Sidebar with a slider input for number of bins
# Sidebar with a slider input for number of bins
sidebarLayout(
sidebarPanel(
sliderInput("bodyweightInput",
"Range of body weight:",
min = -3,
max = 3,
value = c(-2, 2)),
checkboxGroupInput("voreInput",
"Type of animal (diet)",
choices = c("carni", "herbi", "insecti", "omni"),
selected = c("carni", "herbi", "insecti", "omni"))
),
# Show a plot of the generated distribution
mainPanel(
plotlyOutput("CorrelationPlot"),
br(),
htmlOutput("text"),
br(),
dataTableOutput("CorrelationTable")
)
)
)
# Define server logic required to draw a histogram
server <- function(input, output) {
output$CorrelationPlot <- renderPlotly({
msleep$log10bodywt <- log10(msleep$bodywt)
filtered_data <- msleep %>%
filter(vore %in% input$voreInput,
log10bodywt >= input$bodyweightInput[1],
log10bodywt <= input$bodyweightInput[2])
p <- ggplot(data = filtered_data, aes(x = log10bodywt, y = log10(brainwt))) +
geom_smooth(color = "red", method = "lm", se = T, alpha = 0.1, size = 1) +
geom_point(aes(color = vore), size = 2) +
scale_color_viridis_d(name = "Vore", labels = c("Carnivore", "Hervibore", "Insectivore", "Omnivore")) +
labs(
title = "Linear Regression between Brain_Weight and Body_Weight",
subtitle = "Interactive Plotly",
x = "log10(Body_Weight)",
y = "log10(Brain_Weight)",
caption = "Source: msleep"
) +
theme_light()
ggplotly(p)
})
output$text <- renderUI({
msleep$log10bodywt <- log10(msleep$bodywt)
filtered_data <- msleep %>%
filter(vore %in% input$voreInput,
log10bodywt >= input$bodyweightInput[1],
log10bodywt <= input$bodyweightInput[2])
# Computing statistics
counts <- nrow(filtered_data)
# The idea is to compute the total statistics and the counts per tissue
# To print two tagList, we can use "nested tagList", given using two separate ones will only print the latter
tagList(
# General statistics
tagList(
hr(),
strong(paste("Number of selected species: ", counts)),
br(),
br(),
strong(paste("Data table of the filtered dataset:"))
))
})
output$CorrelationTable <- renderDataTable({
msleep$log10bodywt <- log10(msleep$bodywt)
filtered_data <- msleep %>%
filter(vore %in% input$voreInput,
log10bodywt >= input$bodyweightInput[1],
log10bodywt <= input$bodyweightInput[2])
filtered_data
})
}
# Run the application
shinyApp(ui = ui, server = server)
