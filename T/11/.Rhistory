colnames(mice)
mice_sub <- mice %>%
group_by(Diet) %>%              # agrupa por tipo de dieta
sample_n(size = 15) %>%         # toma 15 filas aleatorias de cada grupo
ungroup()                       # quita la agrupación
mice_sub
dim(mice_sub)
