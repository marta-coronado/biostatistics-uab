geom_point(aes(group = id, color = change)) +
geom_smooth(aes(group = 1), color = "black", size = 2, linetype = 2, method = "lm", alpha = 0.1) +
facet_grid(sex ~ group) +
scale_color_manual(values = c("#2166AC", "#D6604D")) +
scale_shape_discrete(name = "Time point") +
labs(
title = "Effect of the Treatment vs Control - Before and After & Stratified by Sex",
subtitle = "Added the linear regression line in black",
y = "Score"
) +
theme_bw() +
theme(
axis.title.x = element_blank(),
legend.position = "bottom"
)
