library(ggplot2)
library(dplyr)
library(tidyr)
set.seed(123)
# Simular pesos 'before' y 'after' (todos aumentan)
n <- 15
before <- rnorm(n, mean = 25, sd = 3)
increase <- runif(n, min = 0.5, max = 3)  # incrementos siempre positivos
after <- before + increase
# Crear wide dataframe (más claro para pareados)
df_wide <- data.frame(
ID = 1:n,
before = before,
after  = after
)
# Comprobación rápida: todas las diferencias son positivas?
df_wide <- df_wide %>% mutate(diff = after - before)
print(df_wide)    # ver la tabla (puedes usar kable(...) para formato pretty)
# Transformar a formato long, asegurando el orden de los niveles
mice_paired <- df_wide %>%
pivot_longer(cols = c(before, after),
names_to = "Time", values_to = "Bodyweight") %>%
mutate(Time = factor(Time, levels = c("before", "after"))) %>%
arrange(ID, Time)   # garantiza que para cada ID el orden sea before -> after
# Plot robusto: geom_segment dibuja una línea por par (no depende del orden de filas)
ggplot() +
# líneas por par (desde x=1 (before) hasta x=2 (after))
geom_segment(data = df_wide,
aes(x = 1, xend = 2, y = before, yend = after),
color = "gray70", size = 0.7, alpha = 0.7) +
# puntos (formato long)
geom_point(data = mice_paired, aes(x = Time, y = Bodyweight, color = Time), size = 3) +
scale_x_continuous(breaks = c(1,2), labels = c("before", "after")) +
scale_color_manual(values = c("before" = "salmon", "after" = "cadetblue3")) +
labs(title = "Paired measurements (robusto)", x = "Time", y = "Bodyweight") +
theme_minimal(base_size = 14) +
theme(legend.position = "none", plot.title = element_text(face = "bold", hjust = 0.5))
c(before, after)
rep(1:n, each = 2)
