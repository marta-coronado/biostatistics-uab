# Líneas verticales
geom_vline(xintercept = c(IC_lower, IC_upper), linetype="dashed", color="blue", size=1) +
geom_vline(xintercept = mu0, linetype="dotted", color="red", size=1.2) +
# Texto de etiquetas
annotate("text", x=mu0, y=max(y)*0.9, label=expression(mu[0]), color="red", fontface="bold") +
annotate("text", x=IC_lower, y=max(y)*0.6, label="IC lower", color="blue") +
annotate("text", x=IC_upper, y=max(y)*0.6, label="IC upper", color="blue") +
labs(title=paste0("Test de dos colas y IC del ", conf_level*100, "%"),
x=expression(mu), y="Densidad") +
ggthemes::theme_base(base_size = 14) +
theme(panel.grid=element_blank(),
axis.text=element_text(color="black"),
panel.background = element_rect(fill="white"))
library(ggplot2)
library(ggthemes)
# Parámetros
mu0 <- 100        # Valor nulo
mu_hat <- 105     # Media muestral observada
SE <- 3           # Error estándar
conf_level <- 0.95
z_star <- qnorm(1 - (1 - conf_level)/2)
# Límites del IC
IC_lower <- mu_hat - z_star*SE
IC_upper <- mu_hat + z_star*SE
# Secuencia para curva normal centrada en mu_hat
x <- seq(mu_hat - 4*SE, mu_hat + 4*SE, length=1000)
y <- dnorm(x, mean=mu_hat, sd=SE)
df <- data.frame(x=x, y=y)
ggplot(df, aes(x=x, y=y)) +
geom_line(size=1.2, color="black") +
# Área dentro del IC
geom_area(data=subset(df, x >= IC_lower & x <= IC_upper), aes(x=x, y=y), fill="cadetblue3", alpha=0.5) +
# Área de colas
geom_area(data=subset(df, x < IC_lower), aes(x=x, y=y), fill="firebrick3", alpha=0.4) +
geom_area(data=subset(df, x > IC_upper), aes(x=x, y=y), fill="firebrick3", alpha=0.4) +
# Líneas verticales
geom_vline(xintercept = c(IC_lower, IC_upper), linetype="dashed", color="blue", size=1) +
geom_vline(xintercept = mu0, linetype="dotted", color="red", size=1.2) +
# Texto de etiquetas
annotate("text", x=mu0, y=max(y)*0.9, label=expression(mu[0]), color="red", fontface="bold") +
annotate("text", x=IC_lower, y=max(y)*0.6, label="IC lower", color="blue") +
annotate("text", x=IC_upper, y=max(y)*0.6, label="IC upper", color="blue") +
labs(title=paste0("Test de dos colas y IC del ", conf_level*100, "%"),
x=expression(mu), y="Densidad") +
ggthemes::theme_base(base_size = 14) +
theme(panel.grid=element_blank(),
axis.text=element_text(color="black"),
panel.background = element_rect(fill="white"))
library(ggplot2)
library(ggthemes)
# Parámetros
mu0 <- 100        # Valor nulo
mu_hat <- 105     # Media muestral observada
SE <- 3           # Error estándar
conf_level <- 0.95
z_star <- qnorm(1 - (1 - conf_level)/2)
# Límites del IC
IC_lower <- mu_hat - z_star*SE
IC_upper <- mu_hat + z_star*SE
# Secuencia para curva normal centrada en mu_hat
x <- seq(mu_hat - 4*SE, mu_hat + 4*SE, length=1000)
y <- dnorm(x, mean=mu_hat, sd=SE)
df <- data.frame(x=x, y=y)
ggplot(df, aes(x=x, y=y)) +
geom_line(size=1.2, color="black") +
# Área dentro del IC
geom_area(data=subset(df, x >= IC_lower & x <= IC_upper), aes(x=x, y=y), fill="cadetblue3", alpha=0.5) +
# Área de colas
geom_area(data=subset(df, x < IC_lower), aes(x=x, y=y), fill="firebrick3", alpha=0.4) +
geom_area(data=subset(df, x > IC_upper), aes(x=x, y=y), fill="firebrick3", alpha=0.4) +
# Líneas verticales
geom_vline(xintercept = c(IC_lower, IC_upper), linetype="dashed", color="blue", size=1) +
geom_vline(xintercept = mu0, linetype="dotted", color="red", size=1.2) +
# Texto de etiquetas con parse=TRUE
annotate("text", x=mu0, y=max(y)*0.9, label="mu[0]", color="red", fontface="bold", parse=TRUE) +
annotate("text", x=IC_lower, y=max(y)*0.6, label="'IC lower'", color="blue") +
annotate("text", x=IC_upper, y=max(y)*0.6, label="'IC upper'", color="blue") +
labs(title=paste0("Test de dos colas y IC del ", conf_level*100, "%"),
x=expression(mu), y="Densidad") +
ggthemes::theme_base(base_size = 14) +
theme(panel.grid=element_blank(),
axis.text=element_text(color="black"),
panel.background = element_rect(fill="white"))
library(ggplot2)
library(ggthemes)
# Datos
mu0 <- 100      # valor nulo
mu_hat <- 105   # media muestral
SE <- 3         # error estándar
conf_level <- 0.95
z_star <- qnorm(1 - (1 - conf_level)/2)
# Límites IC 95% dos colas
IC_lower <- mu_hat - z_star*SE
IC_upper <- mu_hat + z_star*SE
# Secuencia para curva normal centrada en mu_hat
x <- seq(mu_hat - 4*SE, mu_hat + 4*SE, length=1000)
y <- dnorm(x, mean=mu_hat, sd=SE)
df <- data.frame(x=x, y=y)
ggplot(df, aes(x=x, y=y)) +
geom_line(size=1.2, color="black") +
# Área dentro del IC
geom_area(data=subset(df, x >= IC_lower & x <= IC_upper), aes(x=x, y=y), fill="cadetblue3", alpha=0.5) +
# Área de colas (rechazo H0 dos colas)
geom_area(data=subset(df, x < IC_lower), aes(x=x, y=y), fill="firebrick3", alpha=0.4) +
geom_area(data=subset(df, x > IC_upper), aes(x=x, y=y), fill="firebrick3", alpha=0.4) +
# Línea de mu0
geom_vline(xintercept = mu0, linetype="dotted", color="red", size=1.2) +
# Líneas IC
geom_vline(xintercept = c(IC_lower, IC_upper), linetype="dashed", color="blue", size=1) +
# Anotaciones
annotate("text", x=mu0, y=max(y)*0.9, label="mu[0]", color="red", fontface="bold", parse=TRUE) +
annotate("text", x=IC_lower, y=max(y)*0.6, label="'IC lower'", color="blue") +
annotate("text", x=IC_upper, y=max(y)*0.6, label="'IC upper'", color="blue") +
labs(title="Test de dos colas vs. una cola",
x="Media muestral", y="Densidad") +
ggthemes::theme_base(base_size = 14) +
theme(panel.grid=element_blank(),
axis.text=element_text(color="black"),
panel.background = element_rect(fill="white"))
