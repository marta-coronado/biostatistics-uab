library(ggplot2)
library(dplyr)
set.seed(123) # para reproducibilidad
# Simular pesos antes y después de 15 ratones
n <- 15
before <- rnorm(n, mean = 25, sd = 3)
after  <- before + rnorm(n, mean = 2, sd = 0.8)  # todos aumentan un poco
# Crear dataframe en formato largo
mice_paired <- data.frame(
ID = rep(1:n, each = 2),
Time = rep(c("before", "after"), n),
Bodyweight = c(before, after)
)
# Visualizar datos pareados
ggplot(mice_paired, aes(x = Time, y = Bodyweight, group = ID)) +
geom_point(aes(color = Time), size = 3) +
geom_line(alpha = 0.5, color = "gray50") +
theme_minimal(base_size = 14) +
labs(title = "Paired measurements", y = "Bodyweight", x = "Time") +
scale_color_manual(values = c("cadetblue3", "salmon"))
