# Install and load required packages if not already installed
install.packages(c("shiny", "ggplot2", "dplyr"))
library(shiny)
library(ggplot2)
library(dplyr)
# Load the CO2 dataset
data(CO2)
# UI for the Shiny app
ui <- fluidPage(
# Application title
titlePanel("Interactive CO₂ Uptake Visualization - Created by [Your Name]"),
# Sidebar with input widgets
sidebarLayout(
sidebarPanel(
# Select Treatment type
selectInput("treatment",
label = "Select Treatment Type:",
choices = unique(CO2$Treatment),
selected = "Quebec"),
# Select CO₂ concentration range
sliderInput("co2_range",
label = "Select CO₂ Concentration Range:",
min = min(CO2$conc),
max = max(CO2$conc),
value = c(min(CO2$conc), max(CO2$conc)),
step = 1)
),
# Main panel for displaying the plot and data table
mainPanel(
plotOutput("co2_plot"),
tableOutput("data_table")
)
)
)
# Server logic for the Shiny app
server <- function(input, output) {
# Reactive expression to filter data based on user inputs
filtered_data <- reactive({
CO2 %>%
filter(Treatment == input$treatment,
conc >= input$co2_range[1],
conc <= input$co2_range[2])
})
# Render the plot based on the filtered data
output$co2_plot <- renderPlot({
ggplot(filtered_data(), aes(x = conc, y = uptake, color = Treatment)) +
geom_point(alpha = 0.7) +
geom_smooth(method = "lm", se = TRUE) +
theme_minimal() +
labs(title = "CO₂ Uptake vs. CO₂ Concentration",
x = "CO₂ Concentration (ppm)",
y = "CO₂ Uptake (μmol/m²/s)") +
scale_color_manual(values = c("#4C72B0", "#DD8452")) # Custom colors
})
# Render the table based on the filtered data
output$data_table <- renderTable({
filtered_data()
})
}
# Run the application
shinyApp(ui = ui, server = server)
