library(shiny)
library(ggplot2)
library(plotly)
library(dplyr)
# Define UI
ui <- fluidPage(
titlePanel("CO₂ Uptake in Grass Plants"),
sidebarLayout(
sidebarPanel(
selectInput("plant_type", "Select Plant Type:", choices = unique(CO2$Type)),
checkboxGroupInput("treatment", "Select Treatment:", choices = unique(CO2$Treatment), selected = unique(CO2$Treatment)),
sliderInput("conc_range", "CO₂ Concentration Range:", min = min(CO2$conc), max = max(CO2$conc), value = range(CO2$conc))
),
mainPanel(
plotlyOutput("scatter_plot")
)
)
)
# Define Server
server <- function(input, output) {
filtered_data <- reactive({
CO2 %>%
filter(Type == input$plant_type, Treatment %in% input$treatment, conc >= input$conc_range[1], conc <= input$conc_range[2])
})
output$scatter_plot <- renderPlotly({
ggplot(filtered_data(), aes(x = conc, y = uptake, color = Treatment)) +
geom_point(size = 3, alpha = 0.7) +
labs(title = "CO₂ Uptake vs. CO₂ Concentration", x = "CO₂ Concentration (ppm)", y = "CO₂ Uptake (μmol/m²/s)") +
theme_minimal() %>%
ggplotly()
})
}
# Run the app
shinyApp(ui = ui, server = server)
